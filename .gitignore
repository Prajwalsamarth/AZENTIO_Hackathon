# Virtual environment -- recreate with:
#   python3.12 -m venv .venv && .venv/bin/pip install pandas scikit-learn mlx-lm
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Intermediate LoRA checkpoints (~37MB) -- regenerable by rerunning
# `run_finetune.py train`. The SELECTED adapter (adapters.safetensors, 5.6MB)
# stays tracked: it is the saved model, and the dataset that produced it is
# tracked too, so the result is reproducible.
finetune/artifacts/adapters/[0-9]*_adapters.safetensors
finetune/artifacts/adapters/final_adapters.safetensors

# Fitted sklearn artifacts: regenerable with `run_fraud.py fit`
outputs/artifacts/*.pkl
